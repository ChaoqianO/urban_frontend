# Backend base URL used by Vite dev-server proxy (only affects `npm run dev`).
# Set this to the bridge URL when running the dev server against a remote backend
# (e.g. a Tailscale IP). It does NOT affect production Docker builds — those use
# the BACKEND_HOST env var on the nginx container.
VITE_BRIDGE_URL=http://localhost:5000

# Socket.IO endpoint used by the browser at runtime. Leave blank to use same-origin
# (recommended — both dev proxy and prod nginx forward /socket.io to the bridge).
VITE_SOCKET_URL=

# Optional default video feed URLs.
VITE_UAV_FEED_URL=/video_feed?camera=aerial
VITE_UGV_FEED_URL=/video_feed?camera=ground
VITE_CITY_FEED_URL=/video_feed?camera=city
